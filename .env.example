# LLM Provider 
# Global fallback: "gemini" | "openai" | "huggingface"
LLM_PROVIDER=gemini

# Per-chain override (ถ้าไม่ตั้ง จะใช้ LLM_PROVIDER)
# SCREENING_LLM_PROVIDER=gemini
# RAG_EVAL_LLM_PROVIDER=gemini
# GENERATION_LLM_PROVIDER=gemini
# REVIEW_LLM_PROVIDER=gemini

# Per-chain model override (ถ้าไม่ตั้ง จะใช้ default model ของ provider)
# SCREENING_MODEL=gemini-2.0-flash
# RAG_EVAL_MODEL=gemini-2.0-flash
# GENERATION_MODEL=gemini-2.5-pro
# REVIEW_MODEL=gemini-2.0-flash

# Gemini (provider=gemini) 
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenAI (provider=openai) 
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# OCR provider: "gemini" (default) | "openai"
OCR_PROVIDER=gemini

# HuggingFace Inference API (ใช้เมื่อ LLM_PROVIDER=huggingface)
# Free: 1,000 req/5min | PRO: 2,500 req/5min
HF_API_KEY=hf_your-token-here
HF_MODEL=typhoon-ai/llama-3-typhoon-v1.5x-70b-instruct
HF_INFERENCE_PROVIDER=featherless-ai
HF_BASE_URL=https://api-inference.huggingface.co/v1

# Gmail API
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autogmail
DB_USER=postgres
POSTGRES_PASSWORD=your-db-password-here

# ChromaDB
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=fahmai_knowledge_base

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_BM25_TOP_K=20
RAG_DENSE_TOP_K=20
RAG_RERANK_TOP_K=5

# Gmail Pub/Sub (V2-15)
PUBSUB_TOPIC=projects/<GCP_PROJECT_ID>/topics/<TOPIC_NAME>

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Pipeline
MAX_REVIEW_RETRIES=1
LOG_LEVEL=INFO

# MLOps
TRAIN_THRESHOLD=50
BERT_MODEL_PATH=models/bert-email-tagger
